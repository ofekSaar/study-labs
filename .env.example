# ── Backend Configuration ──────────────────────────────
# Secret key used for signing JWT tokens. 
# You can generate a strong secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=super-secret-development-key

# ── Google OAuth Configuration (Optional) ──────────────
# Used for "Login with Google" in the frontend.
# If these are left blank, the backend will use a "Mock Login" flow.
# To get these keys:
# 1. Go to Google Cloud Console (console.cloud.google.com)
# 2. Create credentials -> OAuth client ID (Web application)
# 3. Add Authorized redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI Engine Authentication (Optional) ────────────────
# Protects the internal communication between the Node Backend and the FastAPI Engine.
# The backend will send this key, and the AI engine could verify it (currently not strictly enforced).
AI_SERVICE_API_KEY=internal-secret-key

# ── AI Provider Configuration ──────────────────────────
# Set at least one of these API keys to use the real AI models.
# The AI Engine tries providers in this order: OpenAI -> College -> OpenRouter -> Gemini
# If none are set, make sure USE_MOCK_AI=True to bypass real LLM calls.
GEMINI_API_KEY=
OPENAI_API_KEY=
OPEN_ROUTE_API_KEY=

# Set to True to use mock AI responses instead of calling external LLM providers.
# Useful for local testing without spending API credits. (accepts True/1/yes)
USE_MOCK_AI=False

# ── AI Engine tuning (optional) ────────────────────────
# Model ids per provider — override only if you need a different model.
# OPENAI_MODEL=gpt-4o-mini
# OPENROUTER_MODEL=gpt-4o
# GEMINI_MODEL=models/gemini-flash-latest
# VISION_MODEL=gpt-4o-mini
# Max concurrent LLM calls during content generation.
# MAX_CONCURRENT_AI_CALLS=15
# Validate each quiz question against its summary (1 extra LLM call per question).
# Set to False to roughly halve LLM cost/latency.
# VALIDATE_QUESTION_ALIGNMENT=True

# ── General Configuration ──────────────────────────────
# Maximum number of material files allowed per course upload
MAX_MATERIALS_COUNT=20
